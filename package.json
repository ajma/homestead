{
  "name": "homestead",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Docker Compose manager for home servers and NAS appliances",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "test": "vitest run",
    "test:docker": "HOMESTEAD_DOCKER_TESTS=1 vitest run",
    "dev": "HOMESTEAD_TRUSTED_ORIGINS=http://localhost:5173 tsx watch src/server/index.ts",
    "dev:server:once": "tsx src/server/index.ts",
    "dev:web": "vite",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "1.7.2",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
